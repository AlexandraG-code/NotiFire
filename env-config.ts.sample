window._env_ = {
	// Шаблон хоста GREEN-API: {shard} заменяется первыми 4 цифрами idInstance
	GREEN_API_URL_TEMPLATE: 'https://{shard}.api.green-api.com',

	// Консоль GREEN-API: ссылка в подсказке на форме входа
	GREEN_API_CONSOLE_URL: 'https://console.green-api.com',

	// Таймаут HTTP-запросов, мс
	API_TIMEOUT_MS: '15000',

	// Сколько секунд сервер держит запрос receiveNotification, если уведомлений нет (5–60)
	NOTIFICATION_RECEIVE_TIMEOUT_S: '5',

	// Пауза перед повтором опроса после ошибки, мс
	NOTIFICATION_RETRY_DELAY_MS: '5000',

	// Сколько последних сообщений подгружать из журнала при открытии чата
	HISTORY_MESSAGE_COUNT: '100',

	// Сколько раз искать отправленное сообщение среди уведомлений, прежде чем сдаться
	LINK_ATTEMPTS: '5',

	// Пауза между попытками поиска отправленного сообщения, мс
	LINK_RETRY_DELAY_MS: '1000',

	// Как часто перечитывать настройки инстанса, пока включённые уведомления применяются, мс
	SETTINGS_CHECK_INTERVAL_MS: '15000'
}
